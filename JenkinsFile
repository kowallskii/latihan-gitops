pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  # Kontainer utama untuk build docker
  - name: docker
    image: docker:24.0.5-dind
    securityContext:
      privileged: true
    volumeMounts:
    - name: dind-storage
      mountPath: /var/lib/docker
  # Kontainer pembantu untuk git & shell commands
  - name: base
    image: alpine/git:latest
    command:
    - sleep
    args:
    - infinity
  volumes:
  - name: dind-storage
    emptyDir: {}
"""
        }
    }
    
    environment {
        DOCKER_HUB_USER = 'canda22'
        DOCKER_IMAGE    = "${DOCKER_HUB_USER}/poinpik-apps"
        GIT_REPO_URL    = "github.com/kowallskii/latihan-gitops.git"
    }

    stages {
        stage('Docker Build & Push') {
            steps {
                container('docker') {
                    script {
                        // Menunggu docker daemon siap (penting di Kubernetes)
                        sh 'until docker info; do sleep 1; done'
                        
                        echo "Building Docker Image: ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                        sh "docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ."
                        
                        withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                            sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                            sh "docker push ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                        }
                    }
                }
            }
        }

        stage('Update Manifest di GitHub') {
            steps {
                // Gunakan kontainer 'base' yang sudah ada git-nya
                container('base') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_TOKEN', usernameVariable: 'GIT_USER')]) {
                            sh """
                                # Edit file deploy.yaml
                                sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${env.BUILD_NUMBER}|g" k8s/deploy.yaml
                                
                                git config user.email "jenkins@poinpik.com"
                                git config user.name "Jenkins Bot"
                                
                                git add k8s/deploy.yaml
                                git commit -m "chore: update image version to ${env.BUILD_NUMBER} [skip ci]"
                                git push https://${GIT_USER}:${GIT_TOKEN}@${GIT_REPO_URL} main
                            """
                        }
                    }
                }
            }
        }
    }
}
