pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: docker
    image: docker:24.0.5-dind
    securityContext:
      privileged: true
    volumeMounts:
    - name: dind-storage
      mountPath: /var/lib/docker
  - name: base
    image: alpine/git:latest
    command:
    - sleep
    args:
    - infinity
  volumes:
  - name: dind-storage
    emptyDir: {}
"""
        }
    }

    // --- BAGIAN PARAMETER DIMULAI DI SINI ---
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Input branch yang ingin di-build (contoh: main, staging, dev)')
        choice(name: 'Environment', choices: ['default', 'development', 'production'], description: 'Pilih namespace target deployment')
    }
    // --- BAGIAN PARAMETER SELESAI ---
    
    environment {
        DOCKER_HUB_USER = 'canda22'
        DOCKER_IMAGE    = "${DOCKER_HUB_USER}/poinpik-apps"
        GIT_URL_ONLY    = "github.com/kowallskii/latihan-gitops.git"
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                // Checkout menggunakan parameter BRANCH_NAME
                checkout([$class: 'GitSCM', 
                    branches: [[name: "${params.BRANCH_NAME}"]], 
                    userRemoteConfigs: [[url: "https://${GIT_URL_ONLY}"]]
                ])
            }
        }

        stage('Docker Build & Push') {
            steps {
                container('docker') {
                    script {
                        sh 'until docker info; do sleep 1; done'
                        // Kita tambahkan nama branch ke tag agar tidak tertukar
                        sh "docker build -t ${DOCKER_IMAGE}:${params.BRANCH_NAME}-${env.BUILD_NUMBER} ."
                        
                        withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                            sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                            sh "docker push ${DOCKER_IMAGE}:${params.BRANCH_NAME}-${env.BUILD_NUMBER}"
                        }
                    }
                }
            }
        }

        stage('Update Manifest di GitHub') {
            steps {
                container('base') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_TOKEN', usernameVariable: 'GIT_USER')]) {
                            sh """
                                find . -mindepth 1 -delete
                                git clone https://${GIT_USER}:${GIT_TOKEN}@${GIT_URL_ONLY} repo-temp
                                cd repo-temp
                                
                                # Update tag image dengan menyertakan nama branch
                                sed -i "s|image: ${DOCKER_IMAGE}:.*|image: ${DOCKER_IMAGE}:${params.BRANCH_NAME}-${env.BUILD_NUMBER}|g" k8s/deploy.yaml
                                
                                # Update namespace secara dinamis berdasarkan pilihan parameter 'Environment'
                                sed -i "s|namespace: .*|namespace: ${params.Environment}|g" k8s/deploy.yaml
                                
                                git config user.email "jenkins@poinpik.com"
                                git config user.name "Jenkins Bot"
                                git add k8s/deploy.yaml
                                git commit -m "chore: update image to ${params.BRANCH_NAME}-${env.BUILD_NUMBER} and namespace to ${params.Environment} [skip ci]"
                                git push origin main
                            """
                        }
                    }
                }
            }
        }
    }
}
